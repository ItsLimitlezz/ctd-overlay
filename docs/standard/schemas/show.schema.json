{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://skp.dev/schemas/1/show.schema.json",
  "title": "Show",
  "type": "object",
  "required": ["id", "name", "overlays", "date", "timezone"],
  "properties": {
    "id": { "type": "string", "pattern": "^show_" },
    "rev": { "type": "integer", "minimum": 1, "description": "The edit revision, the show's ETag (03 §3.1): it moves when what PATCH changes does, not with live control (a scene, who's on, REC)." },
    "stateRev": { "type": "integer", "minimum": 1, "description": "Moves with every change, live control included: for a client following the show." },
    "name": { "type": "string" },
    "overlays": { "type": "array", "items": { "type": "string", "pattern": "^ovl_" } },
    "date": { "type": "string", "format": "date" },
    "timezone": { "type": "string", "description": "IANA zone, e.g. America/Toronto." },
    "dayBoundary": { "type": "string", "pattern": "^([01]\\d|2[0-3]):[0-5]\\d$", "default": "12:00" },
    "goLive": { "type": "string", "pattern": "^([01]\\d|2[0-3]):[0-5]\\d$" },
    "scene": { "type": "string" },
    "lineup": {
      "type": "array",
      "items": {
        "type": "object", "required": ["time", "name"],
        "properties": {
          "time": { "type": "string", "pattern": "^([01]\\d|2[0-3]):[0-5]\\d$" },
          "name": { "type": "string" },
          "b2b": { "type": "string" },
          "headliner": { "type": "boolean" },
          "closer": { "type": "boolean" },
          "logo": { "type": "string", "pattern": "^(/media/[A-Za-z0-9_-]+/[^/\\\\?#%\\s]+|https://\\S+)$", "description": "The performer's logo: uploaded media or an https URL (09 §9.1)." }
        }
      }
    },
    "followObs": {
      "type": "object",
      "description": "Follow OBS (09 §9.7): the OBS canvas that drives the show's scene, whose OBS, and OBS scene → the members' scene.",
      "additionalProperties": false,
      "required": ["enabled", "canvas", "map"],
      "properties": {
        "enabled": { "type": "boolean" },
        "canvas": { "enum": ["landscape", "vertical"], "default": "landscape" },
        "source": { "type": "string", "description": "A feed: \"<connection id>\" or \"<connection id>/<profile id>\". Absent: the one feeding the show that reports OBS." },
        "map": {
          "type": "array", "maxItems": 50,
          "items": {
            "type": "object", "additionalProperties": false, "required": ["obsScene", "scene"],
            "properties": {
              "obsScene": { "type": "string", "minLength": 1, "maxLength": 200 },
              "obsSceneUuid": { "type": "string", "maxLength": 100 },
              "scene": { "type": "string", "description": "A member's scene, by id or core." }
            }
          }
        },
        "otherwise": { "type": "string", "description": "The scene for an OBS scene in no row; absent: such a scene changes nothing." }
      }
    },
    "sceneByObs": {
      "type": "object",
      "description": "The scene on now was taken by OBS (read only).",
      "properties": { "at": { "type": "string", "format": "date-time" }, "obsScene": { "type": "string" }, "canvas": { "enum": ["landscape", "vertical"] }, "source": { "type": "string" } }
    },
    "recipe": { "type": "object", "description": "Cue generation recipe (09 §9.5)." }
  }
}
