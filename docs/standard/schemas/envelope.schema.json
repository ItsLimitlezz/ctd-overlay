{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://skp.dev/schemas/1/envelope.schema.json",
  "title": "SKP envelope",
  "description": "Wraps every event and state change on the bus (02 §2.1).",
  "type": "object",
  "required": ["id", "type", "ts", "src", "data"],
  "additionalProperties": false,
  "properties": {
    "id": { "type": "string", "minLength": 10, "description": "Unique, time-sortable (ULID recommended). Doubles as the SSE cursor." },
    "type": {
      "type": "string",
      "pattern": "^(state\\.changed|chat\\.(message|message\\.deleted|user\\.cleared|cleared)|alert\\.[a-z]+|show\\.(scene\\.changed|trigger|cue\\.fired)|media\\.(play|stop)|system\\.(connection|notice)|custom\\.[a-z0-9_.-]+|x-[a-z0-9-]+\\.[a-z0-9_.-]+)$"
    },
    "ts": { "type": "integer", "minimum": 0, "description": "Server epoch milliseconds." },
    "src": {
      "type": "object",
      "required": ["connector"],
      "additionalProperties": false,
      "properties": {
        "connector": { "type": "string" },
        "connection": { "type": "string" },
        "platform": { "type": "string", "enum": ["twitch", "kick", "youtube", "spotify", "obs", "core", "simulator", "custom"] }
      }
    },
    "data": { "type": "object" },
    "meta": {
      "type": "object",
      "properties": { "chatDropped": { "type": "integer", "minimum": 0 } }
    }
  }
}
